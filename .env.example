# Ambiente
NODE_ENV=development
PORT=3333
FRONTEND_URL=http://localhost:3000

# Banco de dados
DATABASE_URL=postgresql://simplifyerp:simplifyerp@localhost:5432/simplifyerp

# Autenticação
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
PASSWORD_RESET_EXPIRATION_MINUTES=30

# MFA (opcional — sem essa chave, o servidor sobe normalmente e o MFA fica indisponível)
# Gere com: openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# Conta inicial de superadministrador (criada automaticamente no boot)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Redis (cache, sessões e filas do BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO (armazenamento de arquivos — ex. logo do estabelecimento, fotos do cardápio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=simplifyerp
MINIO_SECRET_KEY=troque-por-uma-chave-forte
MINIO_BUCKET=simplifyerp

# Observabilidade (opcional)
SENTRY_DSN=

# E-mail transacional via Resend (opcional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SimplifyERP <noreply@example.com>
